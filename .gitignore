# ==========================================
# SmartHaul - Comprehensive .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
*.jks

# ------------------------------------------
# Node.js & Package Managers
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.eslintcache
.stylelintcache

# ------------------------------------------
# Frontend & Next.js (Website)
# ------------------------------------------
.next/
out/
dist/
build/
.vercel/
.turbo/
.parcel-cache/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------
# Backend & Uploads & Database
# ------------------------------------------
uploads/*
!uploads/.gitkeep
Backend/uploads/*
!Backend/uploads/.gitkeep
logs/
*.log
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-journal

# ------------------------------------------
# Testing & Code Coverage
# ------------------------------------------
coverage/
.nyc_output/
*.lcov

# ------------------------------------------
# Flutter / Dart / Mobile (App)
# ------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/doc/api/
app.*.symbols
app.*.map.json

# Android build outputs & configuration
**/android/.gradle/
**/android/captures/
**/android/gradleBuild/
**/android/local.properties
**/android/key.properties
**/android/**/generated/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/app/.cxx/

# iOS / macOS build outputs & configuration
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/app.flx
**/ios/Flutter/flutter_assets/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Pods/
**/ios/.symlinks/
**/ios/DerivedData/
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.sublime-project
.sublime-workspace
*.swp
*.swo
*~
*.bak

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------
# Project Specific & Temporary Files
# ------------------------------------------
tmp/
temp/
*.tmp
/SmartHaul_SRS_v1.0 (Revised).pdf