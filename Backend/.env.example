DATABASE_URL="postgresql://username:password@localhost:5432/smarthaul_db?schema=public"
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key
AES_SECRET_KEY=64_character_hex_string_for_aes_256_encryption_key
AES_IV_LENGTH=16
OSRM_BASE_URL=https://router.project-osrm.org
UPLOAD_DIR=./uploads
SIGNED_URL_EXPIRY_SECONDS=900
# Number of reverse proxies in front of the API (1 on most hosts)
TRUST_PROXY=0
# Comma-separated allowed browser origins (required in production)
CORS_ORIGINS=
FIREBASE_SERVICE_ACCOUNT_PATH=
